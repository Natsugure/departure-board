{
  "name": "departure-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter departure-board-server dev",
    "dev:client": "pnpm --filter departure-board-client dev",
    "dev": "pnpm run --parallel --filter departure-board-server --filter departure-board-client dev",
    "build:server": "pnpm --filter departure-board-server build",
    "build:client": "pnpm --filter departure-board-client build",
    "build": "pnpm --filter departure-board-server build && pnpm --filter departure-board-ui build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "pnpm@10.34.5"
}